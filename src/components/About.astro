---
import site from '../content/site.json';
---

{site.about && (
	<aside>
		<p>{site.about}</p>
	</aside>
)}

<style>
	aside {
		grid-area: about;
		align-self: start;
		/* Starts level with the headline: the logo is five lines tall */
		padding-top: calc(10rem + var(--space-m));
	}
	p {
		margin: 0;
		font-style: italic;
		color: var(--color-muted);
	}
	@media (max-width: 52rem) {
		aside {
			padding-top: 0;
			margin-top: var(--space-l);
			max-width: var(--measure);
		}
	}
</style>
