---
import site from '../content/site.json';
---

{site.about && (
	<aside>
		<p>{site.about}</p>
	</aside>
)}

<style>
	aside {
		grid-area: about;
		align-self: end;
		padding-bottom: var(--space-s);
	}
	p {
		margin: 0;
		font-style: italic;
		color: var(--color-muted);
	}
	@media (max-width: 52rem) {
		aside {
			margin-top: var(--space-l);
			max-width: var(--measure);
		}
	}
</style>
