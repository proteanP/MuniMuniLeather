---
import site from '../content/site.json';
const { contact } = site;
---

<section id="write" aria-labelledby="write-heading">
	<div>
		<h2 id="write-heading">{contact.heading}</h2>
		<p class="intro">{contact.intro}</p>
	</div>
	<form onsubmit="return false">
		<label>
			<span class="label">{contact.fields.name}</span>
			<input name="name" autocomplete="name" required />
		</label>
		<label>
			<span class="label">{contact.fields.email}</span>
			<input name="email" type="email" autocomplete="email" required />
		</label>
		<label class="wide">
			<span class="label">{contact.fields.message}</span>
			<textarea name="message" rows="6" required></textarea>
		</label>
		<div class="wide actions">
			<button class="label" type="submit">{contact.submit} <span aria-hidden="true">→</span></button>
			<p class="notice label">{contact.notice}</p>
		</div>
	</form>
</section>

<style>
	section {
		display: grid;
		grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
		gap: var(--space-l);
		padding-block: var(--space-xl);
	}
	h2 {
		margin: 0;
		font-weight: 400;
		font-size: clamp(2rem, 4vw, 3.25rem);
		line-height: 1;
	}
	.intro {
		color: var(--color-muted);
		max-width: 22rem;
	}
	form {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--space-m);
	}
	.wide {
		grid-column: 1 / -1;
	}
	label span {
		display: block;
		margin-bottom: var(--space-xs);
		color: var(--color-muted);
	}
	input,
	textarea {
		display: block;
		width: 100%;
		box-sizing: border-box;
		padding: 0.75rem;
		border: 1px solid var(--color-ink);
		border-radius: 2px;
		background: var(--color-paper-light);
		color: var(--color-ink);
		font: inherit;
	}
	textarea {
		resize: vertical;
	}
	.actions {
		display: flex;
		align-items: center;
		gap: var(--space-m);
		flex-wrap: wrap;
	}
	button {
		padding: 0.875rem 1.75rem;
		border: 0;
		border-radius: 999px;
		background: var(--color-ink);
		color: var(--color-paper-light);
		cursor: pointer;
	}
	button:hover {
		background: var(--color-accent);
	}
	.notice {
		margin: 0;
		color: var(--color-muted);
		text-transform: none;
		letter-spacing: 0;
	}
	@media (max-width: 52rem) {
		section,
		form {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
