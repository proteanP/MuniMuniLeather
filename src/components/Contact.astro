---
import site from '../content/site.json';
const { contact } = site;
---

<section id="write" aria-labelledby="write-heading">
	<h2 id="write-heading">{contact.heading}</h2>
	<p class="intro">{contact.intro}</p>
	<form onsubmit="return false">
		<label>
			<span>{contact.fields.name}</span>
			<input name="name" autocomplete="name" required />
		</label>
		<label>
			<span>{contact.fields.email}</span>
			<input name="email" type="email" autocomplete="email" required />
		</label>
		<label class="message">
			<span>{contact.fields.message}</span>
			<textarea name="message" rows="5" required></textarea>
		</label>
		<button type="submit">{contact.submit} <span aria-hidden="true">→</span></button>
		<p class="notice">{contact.notice}</p>
	</form>
</section>

<style>
	section {
		padding-top: var(--space-xl);
		max-width: 36rem;
	}
	h2 {
		margin: 0;
		font-family: var(--font-display);
		font-weight: 500;
		font-style: italic;
		font-size: clamp(2.5rem, 5vw, 3.5rem);
		line-height: var(--space-l);
	}
	.intro {
		margin: var(--space-s) 0 var(--space-m);
		color: var(--color-muted);
	}
	label {
		display: block;
		margin-bottom: var(--space-s);
	}
	label span {
		display: block;
		font-family: var(--font-display);
		font-style: italic;
		font-size: 1.25rem;
		color: var(--color-muted);
	}
	input,
	textarea {
		display: block;
		width: 100%;
		box-sizing: border-box;
		border: 0;
		border-bottom: 1px solid var(--color-ink);
		background: transparent;
		font: inherit;
		font-weight: 300;
		color: var(--color-ink);
		padding: 0;
		line-height: var(--line);
	}
	textarea {
		resize: vertical;
		border: 0;
		background-image: repeating-linear-gradient(to bottom, transparent 0 calc(var(--line) - 1px), var(--color-ink) calc(var(--line) - 1px) var(--line));
	}
	input:focus,
	textarea:focus {
		outline: none;
		box-shadow: 0 2px 0 var(--color-accent);
	}
	button {
		margin-top: var(--space-s);
		padding: 0.5rem 1.5rem;
		border: 0;
		background: var(--color-accent);
		color: var(--color-on-accent);
		font-family: var(--font-display);
		font-size: 1.375rem;
		font-style: italic;
		cursor: pointer;
	}
	button:focus-visible {
		outline: 2px solid var(--color-ink);
		outline-offset: 3px;
	}
	.notice {
		font-size: 0.875rem;
		color: var(--color-muted);
	}
</style>
