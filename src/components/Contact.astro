---
import site from '../content/site.json';
const { contact } = site;
---

<form onsubmit="return false">
	<label>
		<span>{contact.fields.name}</span>
		<input name="name" autocomplete="name" required />
	</label>
	<label>
		<span>{contact.fields.email}</span>
		<input name="email" type="email" autocomplete="email" required />
	</label>
	<label class="wide">
		<span>{contact.fields.message}</span>
		<textarea name="message" rows="7" required></textarea>
	</label>
	<div class="wide actions">
		<button type="submit">{contact.submit} <span aria-hidden="true">→</span></button>
		<p>{contact.notice}</p>
	</div>
</form>

<style>
	form {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--space-m);
		max-width: 52rem;
	}
	.wide {
		grid-column: 1 / -1;
	}
	label span {
		display: block;
		margin-bottom: var(--space-xs);
		font-size: 0.875rem;
		font-weight: 500;
	}
	input,
	textarea {
		display: block;
		width: 100%;
		box-sizing: border-box;
		padding: 0.75rem 0.875rem;
		border: 1px solid var(--color-ink);
		border-radius: var(--radius);
		background: var(--color-paper);
		color: var(--color-ink);
		font: inherit;
	}
	textarea { resize: vertical; }
	.actions {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: var(--space-m);
	}
	.actions p {
		margin: 0;
		font-size: 0.875rem;
		color: var(--color-muted);
	}
	button {
		padding: 0.875rem 1.75rem;
		border: 0;
		border-radius: 999px;
		background: var(--color-olive);
		color: var(--color-on-olive);
		font: inherit;
		font-weight: 500;
		cursor: pointer;
	}
	button:hover { background: var(--color-ink); }
	@media (max-width: 40rem) {
		form { grid-template-columns: minmax(0, 1fr); }
	}
</style>
