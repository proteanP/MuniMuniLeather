---
import site from '../content/site.json';
import { url } from '../lib/url';
const { brand } = site;
---

<header>
	<img src={url(`brand/${brand.logo.file}`)} alt={brand.name} width="200" height="200" />
	<h1>{brand.tagline}</h1>
</header>

<style>
	header {
		grid-area: header;
	}
	img {
		display: block;
		width: 10rem;
		height: auto;
		margin-left: -1.25rem;
		mix-blend-mode: multiply;
	}
	h1 {
		margin: var(--space-m) 0 var(--space-l);
		font-family: var(--font-display);
		font-weight: 500;
		font-style: italic;
		font-size: clamp(3.75rem, 8.5vw, 7.5rem);
		line-height: 0.92;
		letter-spacing: -0.02em;
		max-width: 9ch;
	}
</style>
