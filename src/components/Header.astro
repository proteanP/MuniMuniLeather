---
import site from '../content/site.json';
const { brand } = site;
---

<header>
	<img src={`/${brand.logo.file}`} alt={brand.logo.alt} width="96" height="96" />
	<h1>{brand.name}</h1>
	<p>{brand.tagline}</p>
</header>

<style>
	img {
		border-radius: 50%;
	}
	h1 {
		font-family: var(--font-display);
		font-weight: normal;
	}
</style>
