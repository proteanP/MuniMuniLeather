---
import site from '../content/site.json';
import { url } from '../lib/url';
const { brand, links } = site;
const shown = Object.values(links).filter((link) => link.url);
---

<header>
	<a class="logo" href={url('')}>
		<img src={url(`brand/${brand.logo.file}`)} alt={brand.name} width="200" height="200" />
	</a>
	<nav aria-label="Links">
		{shown.map((link) => (
			<a class="label" href={link.url}>{link.label}</a>
		))}
	</nav>
</header>

<style>
	header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: var(--space-s) var(--gutter);
	}
	img {
		display: block;
		width: 7.5rem;
		height: auto;
		margin-left: -0.75rem;
		mix-blend-mode: multiply;
	}
	nav {
		display: flex;
		gap: var(--space-m);
		flex-wrap: wrap;
		justify-content: flex-end;
	}
	nav a {
		color: var(--color-ink);
		text-decoration: none;
		border-bottom: 1px solid currentColor;
		padding-bottom: 2px;
	}
	nav a:hover {
		color: var(--color-accent);
	}
</style>
