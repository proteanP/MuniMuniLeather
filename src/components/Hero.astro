---
import site from '../content/site.json';
import { url } from '../lib/url';
const hero = site.photos[0];
---

<section class="hero">
	<div class="text">
		<p class="eyebrow">{site.brand.tagline}</p>
		<h1>{site.headline}</h1>
		{site.about && <p class="about">{site.about}</p>}
	</div>
	{hero && (
		<figure>
			<img src={url(`photos/${hero.file}`)} alt={hero.alt} width="1000" height="1000" />
		</figure>
	)}
</section>

<style>
	.hero {
		display: grid;
		grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
		gap: var(--space-l);
		align-items: center;
		padding: var(--space-l) 0 var(--space-xl);
	}
	h1 {
		font-size: clamp(3rem, 7.4vw, 7.25rem);
		line-height: 0.92;
	}
	.about {
		max-width: 30rem;
		margin: var(--space-m) 0 0;
		color: var(--color-muted);
	}
	/* The photo sits on an offset olive block, like a piece on a leather offcut */
	figure {
		position: relative;
		margin: 0 var(--space-m) var(--space-m) 0;
	}
	figure::before {
		content: "";
		position: absolute;
		inset: var(--space-m) calc(var(--space-m) * -1) calc(var(--space-m) * -1) var(--space-m);
		background: var(--color-olive);
		border-radius: var(--radius);
	}
	img {
		position: relative;
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		border-radius: var(--radius);
		animation: rise 1s 0.15s cubic-bezier(.2, .7, .2, 1) both;
	}
	@keyframes rise {
		from { transform: translate(var(--space-m), var(--space-m)); }
	}
	@media (prefers-reduced-motion: reduce) {
		img { animation: none; }
	}
	@media (max-width: 52rem) {
		.hero {
			grid-template-columns: minmax(0, 1fr);
			padding-bottom: var(--space-l);
		}
	}
</style>
