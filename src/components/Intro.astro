---
import site from '../content/site.json';
---

<section class="intro">
	<p class="label tag">{site.brand.tagline}</p>
	<h1>{site.headline}</h1>
	{site.about && <p class="about">{site.about}</p>}
	<svg class="seam" viewBox="0 0 1200 12" preserveAspectRatio="none" aria-hidden="true">
		<line x1="0" y1="6" x2="1200" y2="6" />
	</svg>
</section>

<style>
	.intro {
		display: grid;
		grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
		column-gap: var(--space-l);
		align-items: end;
		padding-top: var(--space-l);
	}
	.tag {
		grid-column: 1 / -1;
		margin: 0 0 var(--space-s);
		color: var(--color-accent);
	}
	h1 {
		margin: 0;
		font-weight: 400;
		font-size: clamp(2.75rem, 7.2vw, 7rem);
		line-height: 0.98;
		letter-spacing: -0.025em;
	}
	.about {
		margin: 0;
		max-width: var(--measure);
		color: var(--color-muted);
		padding-bottom: 0.6rem;
	}
	.seam {
		grid-column: 1 / -1;
		width: 100%;
		height: 12px;
		margin-top: var(--space-l);
	}
	.seam line {
		stroke: var(--color-ink);
		stroke-width: 2;
		stroke-dasharray: 10 6;
		animation: sew 1.6s cubic-bezier(.5, 0, .2, 1) both;
		clip-path: inset(0 0 0 0);
	}
	@keyframes sew {
		from { clip-path: inset(0 100% 0 0); }
	}
	@media (prefers-reduced-motion: reduce) {
		.seam line { animation: none; }
	}
	@media (max-width: 52rem) {
		.intro {
			grid-template-columns: minmax(0, 1fr);
			row-gap: var(--space-m);
		}
	}
</style>
