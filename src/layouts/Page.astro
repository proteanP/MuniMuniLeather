---
import '../styles/tokens.css';
import site from '../content/site.json';
import { url } from '../lib/url';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
interface Props { title?: string; current?: string }
const { title, current } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
		<link rel="icon" href={url('favicon.ico')} />
		<title>{title ? `${title} · ${site.brand.name}` : site.meta.title}</title>
		<meta name="description" content={site.meta.description} />
	</head>
	<body>
		<Nav current={current} />
		<main><slot /></main>
		<Footer />
	</body>
</html>

<style is:global>
	html {
		background: var(--color-paper);
	}
	body {
		margin: 0;
		color: var(--color-ink);
		font-family: var(--font-body);
		font-size: 1.0625rem;
		line-height: 1.65;
		min-height: 100vh;
		display: flex;
		flex-direction: column;
	}
	main {
		flex: 1;
		width: 100%;
		max-width: var(--wide);
		margin: 0 auto;
		padding: 0 var(--gutter);
		box-sizing: border-box;
	}
	a {
		color: var(--color-accent);
	}
	:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 3px;
	}
	h1, h2, h3 {
		font-family: var(--font-display);
		font-weight: 400;
		line-height: 1.02;
		letter-spacing: -0.01em;
		margin: 0;
	}
	.eyebrow {
		font-size: 0.75rem;
		font-weight: 500;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--color-accent);
		margin: 0 0 var(--space-s);
	}
	.page-head {
		padding: var(--space-l) 0 var(--space-l);
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, var(--measure));
		gap: var(--space-l);
		align-items: end;
		border-bottom: 1px solid var(--color-ink);
		margin-bottom: var(--space-l);
	}
	.page-head h1 {
		font-size: clamp(3rem, 9vw, 8.5rem);
		line-height: 0.9;
	}
	.page-head p {
		margin: 0;
		color: var(--color-muted);
	}
	@media (max-width: 52rem) {
		.page-head {
			grid-template-columns: minmax(0, 1fr);
			gap: var(--space-s);
		}
	}
</style>
