---
import '../styles/tokens.css';
import site from '../content/site.json';
import { url } from '../lib/url';
import Header from '../components/Header.astro';
import About from '../components/About.astro';
import Links from '../components/Links.astro';
import Gallery from '../components/Gallery.astro';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href={url("favicon.svg")} />
		<link rel="icon" href={url("favicon.ico")} />
		<title>{site.meta.title}</title>
		<meta name="description" content={site.meta.description} />
	</head>
	<body>
		<main>
			<Header />
			<div class="intro">
				<About />
				<Links />
			</div>
			<div class="gallery"><Gallery /></div>
		</main>
	</body>
</html>

<style is:global>
	html {
		background: var(--color-paper);
	}
	body {
		margin: 0;
		color: var(--color-ink);
		font-family: var(--font-body);
		background-image: var(--paper-grain);
	}
	main {
		padding: var(--space-l) var(--gutter) var(--gutter);
	}
	/* The sentence and the links: side by side, stacked on phones and beside the logo on wide screens */
	.intro {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: flex-end;
		gap: var(--space-l);
		margin: var(--space-l) 0 var(--space-xl);
	}
	/* Wide screens: logo on the left, sentence and links beside it, photos below */
	@media (min-width: 64rem) {
		main {
			display: grid;
			grid-template-columns: minmax(0, 55rem) minmax(0, 24rem);
			justify-content: center;
			column-gap: var(--space-xl);
			row-gap: var(--space-l);
			max-width: 96rem;
			margin-inline: auto;
		}
		.intro {
			flex-direction: column;
			align-items: flex-start;
			justify-content: flex-end;
			gap: var(--space-m);
			align-self: end;
			margin: 0;
		}
		.gallery {
			grid-column: 1 / -1;
		}
	}
	@media (max-width: 40rem) {
		main {
			padding-top: var(--space-m);
		}
		.intro {
			flex-direction: column;
			align-items: flex-start;
			gap: var(--space-m);
			margin: var(--space-m) 0 var(--space-l);
		}
	}
</style>
