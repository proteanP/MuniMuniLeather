---
import '../styles/tokens.css';
import site from '../content/site.json';
import { url } from '../lib/url';
import Header from '../components/Header.astro';
import Links from '../components/Links.astro';
import About from '../components/About.astro';
import Contact from '../components/Contact.astro';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href={url("favicon.svg")} />
		<link rel="icon" href={url("favicon.ico")} />
		<title>{site.meta.title}</title>
		<meta name="description" content={site.meta.description} />
	</head>
	<body>
		<main>
			<div class="card">
				<Header />
				<Links />
				<About />
			</div>
			<Contact />
		</main>
		<footer>{site.footer}</footer>
	</body>
</html>

<style is:global>
	html {
		background: var(--color-paper);
	}
	body {
		margin: 0;
		color: var(--color-ink);
		font-family: var(--font-body);
		font-weight: 300;
		font-size: 1.125rem;
		line-height: var(--line);
		background-image:
			var(--paper-grain),
			repeating-linear-gradient(to bottom, transparent 0 calc(var(--line) - 1px), var(--color-rule) calc(var(--line) - 1px) var(--line));
		/* Shift the rules so text baselines sit on them */
		background-position: 0 0, 0 calc(var(--line) * -0.3);
		min-height: 100vh;
		position: relative;
	}
	/* The notebook's margin line */
	body::before {
		content: "";
		position: absolute;
		inset: 0 auto 0 var(--margin-line);
		width: 1px;
		background: var(--color-accent);
		opacity: 0.55;
		transform-origin: top;
		animation: draw 1.4s cubic-bezier(.6, 0, .2, 1) both;
	}
	@keyframes draw {
		from { transform: scaleY(0); }
	}
	@media (prefers-reduced-motion: reduce) {
		body::before { animation: none; }
	}
	main {
		padding: var(--space-l) var(--space-m) 0 calc(var(--margin-line) + var(--space-m));
		max-width: 76rem;
	}
	.card {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 20rem);
		grid-template-areas: "header about" "links about";
		column-gap: var(--space-xl);
		align-content: start;
		min-height: calc(100vh - var(--space-xl));
	}
	a {
		color: var(--color-accent);
	}
	footer {
		padding: var(--space-l) var(--space-m) var(--space-m) calc(var(--margin-line) + var(--space-m));
		font-family: var(--font-display);
		font-style: italic;
		color: var(--color-muted);
	}
	@media (max-width: 52rem) {
		.card {
			min-height: 0;
			grid-template-columns: minmax(0, 1fr);
			grid-template-areas: "header" "links" "about";
		}
	}
</style>
